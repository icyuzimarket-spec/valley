SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme-prefixed origins allowed to POST (e.g. https://yourusername.pythonanywhere.com)
CSRF_TRUSTED_ORIGINS=
# Set to False only if you are not serving over HTTPS (not recommended in production)
SECURE_SSL_REDIRECT=True
# Managed database connection string. Leave blank to use the local SQLite file.
# Required on hosts with an ephemeral disk (e.g. Railway), where SQLite is wiped
# on every deploy. Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=
# Optional: creates the admin account during `migrate` on hosts without a
# usable shell. Skipped unless both are set; never overwrites an existing
# account (so changing ADMIN_PASSWORD does not reset the password).
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Valley Admin
# Cloudflare R2 for payment screenshots. All of bucket + both keys + an
# endpoint must be set, otherwise uploads fall back to local disk.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT is derived from R2_ACCOUNT_ID when left blank.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
